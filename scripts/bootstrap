#!/bin/sh
set -eu

REPO_DIR=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
BREW_DIR="$REPO_DIR/dependencies/brew"
EXTERNAL_DIR="$REPO_DIR/dependencies/external"

log() {
  printf '%s\n' "$*"
}

have_cmd() {
  command -v "$1" >/dev/null 2>&1
}

run_cmd() {
  if [ "${DRY_RUN:-0}" = "1" ]; then
    log "[dry-run] $*"
    return 0
  fi
  "$@"
}

brew_bin() {
  if have_cmd brew; then
    command -v brew
    return 0
  fi

  if [ -x /opt/homebrew/bin/brew ]; then
    printf '/opt/homebrew/bin/brew\n'
    return 0
  fi

  if [ -x /usr/local/bin/brew ]; then
    printf '/usr/local/bin/brew\n'
    return 0
  fi

  return 1
}

install_homebrew_if_missing() {
  if brew_bin >/dev/null 2>&1; then
    return 0
  fi

  case "$(uname -s)" in
    Darwin|Linux)
      log "Homebrew not found. Installing Homebrew..."
      if [ "${DRY_RUN:-0}" = "1" ]; then
        log "[dry-run] install Homebrew using official installer"
        return 0
      fi
      NONINTERACTIVE=1 /bin/sh -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      ;;
    *)
      log "Unsupported OS for automatic Homebrew installation: $(uname -s)"
      return 1
      ;;
  esac
}

install_taps() {
  brew="$1"
  file="$BREW_DIR/taps.txt"
  [ -f "$file" ] || return 0

  while IFS= read -r tap || [ -n "$tap" ]; do
    case "$tap" in
      ''|'#'*) continue ;;
    esac

    if "$brew" tap | grep -Fx "$tap" >/dev/null 2>&1; then
      log "tap already installed: $tap"
    else
      log "installing tap: $tap"
      if ! run_cmd "$brew" tap "$tap"; then
        log "warning: failed to install tap '$tap'; continuing"
      fi
    fi
  done < "$file"
}

install_formulae() {
  brew="$1"
  file="$BREW_DIR/formulae.txt"
  [ -f "$file" ] || return 0

  while IFS= read -r formula || [ -n "$formula" ]; do
    case "$formula" in
      ''|'#'*) continue ;;
    esac

    if "$brew" list --formula "$formula" >/dev/null 2>&1; then
      log "formula already installed: $formula"
    else
      log "installing formula: $formula"
      run_cmd "$brew" install "$formula"
    fi
  done < "$file"
}

install_casks() {
  brew="$1"
  file="$BREW_DIR/casks.txt"
  [ -f "$file" ] || return 0

  while IFS= read -r cask || [ -n "$cask" ]; do
    case "$cask" in
      ''|'#'*) continue ;;
    esac

    if "$brew" list --cask "$cask" >/dev/null 2>&1; then
      log "cask already installed: $cask"
    else
      log "installing cask: $cask"
      run_cmd "$brew" install --cask "$cask"
    fi
  done < "$file"
}

run_external_installers() {
  file="$EXTERNAL_DIR/installers.txt"
  [ -f "$file" ] || return 0

  while IFS= read -r installer || [ -n "$installer" ]; do
    case "$installer" in
      ''|'#'*) continue ;;
    esac

    installer_path="$EXTERNAL_DIR/$installer"
    if [ ! -f "$installer_path" ]; then
      log "external installer missing: $installer_path"
      return 1
    fi

    log "running external installer: $installer"
    if [ "${DRY_RUN:-0}" = "1" ]; then
      log "[dry-run] sh $installer_path"
    else
      sh "$installer_path"
    fi
  done < "$file"
}

main() {
  install_homebrew_if_missing

  BREW=$(brew_bin)
  if [ -z "$BREW" ]; then
    log "Homebrew installation failed or brew is still unavailable"
    exit 1
  fi

  log "using brew: $BREW"
  run_cmd "$BREW" update
  install_taps "$BREW"
  install_formulae "$BREW"
  install_casks "$BREW"
  run_external_installers
}

main "$@"
